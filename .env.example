# Copy to .env (git-ignored) and fill in. Never commit .env.

# LLM-as-a-judge (scripts/judge.py, `make judge`)
JUDGE_PROVIDER=openai
JUDGE_MODEL=gpt-6-luna
OPENAI_API_KEY=
# Alternative: JUDGE_PROVIDER=anthropic with ANTHROPIC_API_KEY=

# Server (make dev). In production these are Vercel environment variables.
ASSIST_MODE=on
FLOWASSIST_ENV=demo
